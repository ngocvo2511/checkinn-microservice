# Historical/operator bootstrap template, not the daily application config.
# Daily runtime: docker/.env (docker/.env.example). Test: docker/.env.test.
# Management/migrator inputs remain private under .local/batch6b.
# Populate privately. Spring Boot does not automatically load .env.
SPRING_PROFILES_ACTIVE=supabase-dev
# Fresh session-specific local JWT/NextAuth secrets; never copy legacy/provider credentials.
SECRET_KEY=
NEXTAUTH_SECRET=
# Optional ephemeral fake merchant key for LOCAL callback simulation only, never a provider credential.
BATCH6B_TEST_VNPAY_HASH_SECRET=
# Explicit provider modes: simulated/sandbox and disabled/supabase. No production endpoint fallback.
SUPABASE_DEV_VNPAY_MODE=simulated
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/booking/payment/return
SUPABASE_DEV_STORAGE_MODE=disabled
SUPABASE_STORAGE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=hotel_storage
SUPABASE_PRIVATE_BUCKET=hotel-documents
SUPABASE_DEV_DATABASES_READY=false
SUPABASE_DEV_INFRA_ISOLATED=false
SUPABASE_DEV_SESSION=
SUPABASE_DEV_RABBIT_PORT=
SUPABASE_DEV_RABBIT_USERNAME=
SUPABASE_DEV_RABBIT_PASSWORD=
SUPABASE_DEV_RABBIT_VHOST=
SUPABASE_DEV_REDIS_PORT=
SUPABASE_DEV_REDIS_DATABASE=
