# Local development only. Copy to .env (ignored by Git); never use production databases.
# Generate private random SECRET_KEY (at least 32 bytes) and NEXTAUTH_SECRET before app/web startup.
SECRET_KEY=
NEXTAUTH_SECRET=
RABBIT_USER=checkinn
RABBIT_PASS=local-development-only
RABBIT_MANAGEMENT_PORT=15672
EUREKA_PORT=8761
ADMIN_PORT=9095
GATEWAY_PORT=8080
CONFIG_PORT=8888
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXTAUTH_URL=http://localhost:3000

USER_DB_URL=jdbc:postgresql://host.docker.internal:5432/checkinn_user
USER_DB_USERNAME=postgres
USER_DB_PASSWORD=

HOTEL_DB_URL=jdbc:postgresql://host.docker.internal:5432/checkinn_hotel
HOTEL_DB_USERNAME=postgres
HOTEL_DB_PASSWORD=

BOOKING_DB_URL=jdbc:postgresql://host.docker.internal:5432/checkinn_booking
