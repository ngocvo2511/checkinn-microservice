# Main application configuration: copy to .env (private).
# Start: ./stack.ps1 -Environment Supabase -Action Up
# Local PostgreSQL tests use .env.test.example -> .env.test, never this file.
# Supabase here is the current local app + hosted DB setup, not production deployment.
CHECKINN_ENVIRONMENT=supabase
SECRET_KEY=
NEXTAUTH_SECRET=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Build-time switch for the community routes; changing it requires rebuilding the frontend image.
NEXT_PUBLIC_COMMUNITY_ENABLED=false
NEXTAUTH_URL=http://localhost:3000

# Dedicated runtime roles only. Use the session pooler (5432), verify-full and
# a verified CA path on this host; the launcher maps that CA into Linux containers.
# Keep management tokens, migrator passwords and approval manifests under .local.
USER_DB_URL=jdbc:postgresql://<session-pooler>:5432/postgres?sslmode=verify-full&sslrootcert=<host-ca-path>&currentSchema=public&connectTimeout=10&socketTimeout=30
USER_DB_USERNAME=checkinn_user_app.<project-ref>
USER_DB_PASSWORD=
USER_DB_PROJECT_REF=
USER_DB_RUNTIME_ROLE=checkinn_user_app
USER_DB_POOL_MAX=2
USER_DB_CONNECTION_BUDGET=7

HOTEL_DB_URL=jdbc:postgresql://<session-pooler>:5432/postgres?sslmode=verify-full&sslrootcert=<host-ca-path>&currentSchema=public&connectTimeout=10&socketTimeout=30
HOTEL_DB_USERNAME=checkinn_hotel_app.<project-ref>
HOTEL_DB_PASSWORD=
HOTEL_DB_PROJECT_REF=
HOTEL_DB_RUNTIME_ROLE=checkinn_hotel_app
HOTEL_DB_POOL_MAX=2
HOTEL_DB_CONNECTION_BUDGET=7

BOOKING_DB_URL=jdbc:postgresql://<session-pooler>:5432/postgres?sslmode=verify-full&sslrootcert=<host-ca-path>&currentSchema=public&connectTimeout=10&socketTimeout=30
BOOKING_DB_USERNAME=checkinn_booking_app.<project-ref>
BOOKING_DB_PASSWORD=
BOOKING_DB_PROJECT_REF=
BOOKING_DB_RUNTIME_ROLE=checkinn_booking_app
BOOKING_DB_POOL_MAX=2
BOOKING_DB_CONNECTION_BUDGET=7

REVENUE_DB_URL=jdbc:postgresql://<session-pooler>:5432/postgres?sslmode=verify-full&sslrootcert=<host-ca-path>&currentSchema=public&connectTimeout=10&socketTimeout=30
REVENUE_DB_USERNAME=checkinn_revenue_app.<project-ref>
REVENUE_DB_PASSWORD=
REVENUE_DB_PROJECT_REF=
REVENUE_DB_RUNTIME_ROLE=checkinn_revenue_app
REVENUE_DB_POOL_MAX=2
REVENUE_DB_CONNECTION_BUDGET=7

REGULATIONS_DB_URL=jdbc:postgresql://<session-pooler>:5432/postgres?sslmode=verify-full&sslrootcert=<host-ca-path>&currentSchema=public&connectTimeout=10&socketTimeout=30
REGULATIONS_DB_USERNAME=checkinn_regulations_app.<project-ref>
REGULATIONS_DB_PASSWORD=
REGULATIONS_DB_PROJECT_REF=
REGULATIONS_DB_RUNTIME_ROLE=checkinn_regulations_app
REGULATIONS_DB_POOL_MAX=2
REGULATIONS_DB_CONNECTION_BUDGET=7

SUPABASE_DEV_VNPAY_MODE=sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/booking/payment/return
SUPABASE_DEV_STORAGE_MODE=disabled
SUPABASE_STORAGE_PROJECT_REF=

# travel-social-service. Create the empty database once (createdb checkinn_social); Flyway builds the schema.
SOCIAL_DB_URL=jdbc:postgresql://host.docker.internal:5432/checkinn_social
SOCIAL_DB_USERNAME=postgres
SOCIAL_DB_PASSWORD=
PLACE_DB_URL=jdbc:postgresql://host.docker.internal:5432/checkinn_place
PLACE_DB_USERNAME=postgres
PLACE_DB_PASSWORD=
# Leave unset to use the place-service container; point at host.docker.internal:8087 to use one running on the host.
# PLACE_SERVICE_URL=http://place-service:8087

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=hotel_storage
SUPABASE_PRIVATE_BUCKET=hotel-documents
# Explicit reviewed demo flag, same value for Booking and Revenue.
REFUND_INTERNAL_ENABLED=false
