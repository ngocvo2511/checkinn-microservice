# Copy to .env.test for stack.ps1 -Environment Test.
# Test database URLs are fixed by docker-compose.test.yml to postgres-test:5432.
# For an existing test volume, retain its existing password; do not regenerate it.
CHECKINN_ENVIRONMENT=test
TEST_POSTGRES_PASSWORD=
SECRET_KEY=
NEXTAUTH_SECRET=
RABBIT_USER=checkinn
RABBIT_PASS=local-development-only
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXTAUTH_URL=http://localhost:3000
# Mailpit is wired by the Test overlay. External providers are not configured.
SUPABASE_URL=http://127.0.0.1:9
SUPABASE_SERVICE_ROLE_KEY=unconfigured-local-storage
SUPABASE_BUCKET=local-test-unconfigured
SUPABASE_PRIVATE_BUCKET=local-test-private-unconfigured
VNPAY_TMN_CODE=B6BTEST1
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/booking/payment/return
REFUND_INTERNAL_ENABLED=false
